{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mynaani v9.51 Requirements Knowledge Graph",
  "description": "Canonical schema for the PROCESS_V9.51_SPEC.md §19 knowledge graph.",
  "type": "object",
  "required": ["ontology", "metadata", "nodes", "edges"],
  "properties": {
    "ontology": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "entities": { "type": "array", "items": { "type": "string" } },
        "relationships": { "type": "array", "items": { "type": "string" } }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["repo", "date", "node_count", "edge_count", "graph_hash"],
      "properties": {
        "repo": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "node_count": { "type": "integer" },
        "edge_count": { "type": "integer" },
        "graph_hash": { "type": "string" }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "id", "name"],
        "properties": {
          "kind": { "enum": ["SourceArtifact", "Requirement", "Capability", "Epic", "UserStory", "AcceptanceCriterion", "Test", "Evidence", "Owner", "Decision", "Dependency", "Gap", "Conflict", "Assumption", "Persona", "Journey", "BudgetProfile", "CostEvent", "RoutingDecision"] },
          "id": { "type": "string" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "authority": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "extraction_method": { "enum": ["structured_source", "rule_based", "llm_inferred", "human_confirmed"] },
          "description": { "type": "string" },
          "status": { "type": "string" },
          "owner_id": { "type": "string" },
          "next_action": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "relation", "to"],
        "properties": {
          "from": { "type": "string" },
          "relation": { "type": "string" },
          "to": { "type": "string" },
          "provenance": { "type": "string" }
        }
      }
    }
  }
}
