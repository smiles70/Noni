{
  "name": "noni-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "type-check": "npm run type-check --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "test:unit": "npm run test:unit --workspace=frontend",
    "test:coverage": "npm run test:coverage --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "lint:fix": "npm run lint:fix --workspace=frontend",
    "format:check": "npm run format:check --workspace=frontend",
    "format": "npm run format --workspace=frontend",
    "lint:timers": "npm run lint:timers --workspace=frontend",
    "lint:licenses": "npm run lint:licenses --workspace=frontend",
    "prepare": "husky"
  },
  "devDependencies": {
    "jsdom": "^24.0.0",
    "lint-staged": "^16.4.0"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0 --config frontend/eslint.config.js"
    ]
  }
}
