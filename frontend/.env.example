# Frontend environment (Vite). Copy to `.env` and customize.
# Only variables prefixed with VITE_ are visible to client code.

# Identity provider: "mock" (default; pairs with backend MockAuthProvider)
# or "magic" (production; see ADR 0027).
VITE_AUTH_PROVIDER=mock

# Magic publishable key — required when VITE_AUTH_PROVIDER=magic.
# Find under Magic Dashboard -> API Keys.
VITE_MAGIC_PUBLISHABLE_KEY=

# Supabase project URL — required when VITE_AUTH_PROVIDER=supabase.
# Find under Project Settings -> API -> Project URL.
VITE_SUPABASE_URL=

# Retell website chat widget (ADR 0032) — caregiver/facility journeys only.
# Public key is browser-safe by design and MUST be domain-locked in the
# Retell dashboard (API Keys -> Public Keys). Unset => ChatWidget no-ops.
VITE_RETELL_PUBLIC_KEY=
VITE_RETELL_CHAT_AGENT_ID=agent_646dba13a4321b698970c15c68
