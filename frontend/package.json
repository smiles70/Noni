{
  "name": "noni-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/verify-build-env.mjs",
    "build": "npm run prebuild && tsc -b && vite build",
    "postbuild": "node scripts/verify-bundle.mjs",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "bundle-size": "node scripts/check-bundle-size.mjs",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "test:coverage": "vitest run --coverage",
    "lint:circular": "madge --circular src/",
    "lint:dead-code": "knip",
    "lint:complexity": "eslint src/ --max-warnings 0 --rule 'sonarjs/cognitive-complexity: warn'",
    "lint:licenses": "license-checker --onlyunknown --summary",
    "lint:timers": "node -e \"const{execSync}=require('child_process');try{const out=execSync('grep -rn window\\\\.setTimeout src/ --include=*.ts --include=*.tsx',{encoding:'utf8',stdio:['pipe','pipe','ignore']});if(out.trim()){console.error('ERROR: window.setTimeout found in shared code:');console.error(out);process.exit(1);}}catch(e){if(e.status===1&&(!e.stdout||e.stdout==='')){console.log('Timer lint: PASS');process.exit(0);}else{console.error('Timer lint error:',e.message);process.exit(1);}}console.log('Timer lint: PASS');\"",
    "prepare": "husky"
  },
  "dependencies": {
    "magic-sdk": "~33.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-playwright": "^2.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "license-checker": "^25.0.1",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
